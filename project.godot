[application]
config/name="Tic-Tac-Toe"
config/version="0.3"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=400
window/size/viewport_height=760
window/size/window_width_override=1100
window/size/window_height_override=790
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.945, 0.922, 0.863, 1)

[web]
export/enable_http_server=true
export/http_port=8081

[gui]
theme/default_font_multichannel_signed_distance_field=true
